<UserControl x:Class="Avalonia.Desktop.UserControls.MainLists"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Avalonia.Desktop.Helpers"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdv="clr-namespace:Avalonia.Desktop.UserControls"
             xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!--Games list-->
        <ListBox x:Name="GamesListBox"
                 Grid.Column="0"
                 Margin="0,0,3,0"
                 Padding="5"
                 ItemsSource="{Binding FilteredGamesList, Mode=OneWay}"
                 ScrollViewer.AllowAutoHide="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                 SelectionChanged="ListBox_SelectionChanged">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Grid Margin="5"
                          Background="Transparent"
                          ColumnDefinitions="auto,auto"
                          RowDefinitions="*,auto">

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LaunchGameCommand}"
                                          Header="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LaunchGameButtonText}" />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameFolderCommand}"
                                          Header="Open game folder..." />
                                <Separator />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSteamClientCommand}"
                                          Header="Open on Steam client..." />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSteamStoreCommand}"
                                          Header="Open on Steam store..." />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenPCGamingWikiCommand}"
                                          Header="Open PCGamingWiki page..." />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSteamDBCommand}"
                                          Header="Open SteamDB page..." />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Width="36"
                                Height="36"
                                Background="Black"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsVisible="{Binding IsGameInstalled}">
                            <Image Width="32"
                                   Height="32"
                                   Source="{Binding Game.Icon, Converter={StaticResource ImagePathToBitmapConverter}}"
                                   Stretch="Fill" />
                        </Border>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Classes.IsGameUninstalled="{Binding !IsGameInstalled}"
                                   Classes.IsInstalled="{Binding HasInstalledFixes}"
                                   Text="{Binding GameName}">

                            <TextBlock.Styles>
                                <Style Selector="TextBlock.IsGameUninstalled">
                                    <Style.Setters>
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Style.Setters>
                                </Style>
                                <Style Selector="TextBlock.IsInstalled">
                                    <Style.Setters>
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style.Setters>
                                </Style>
                                <Style Selector="TextBlock">
                                    <Style.Setters>
                                        <Setter Property="Margin" Value="5,2" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style.Setters>
                                </Style>
                            </TextBlock.Styles>

                        </TextBlock>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="5,2"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding HasUpdates}"
                                   Text="Attention required" />

                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!--Fixes list-->
        <ListBox Name="FixesList"
                 Grid.Column="1"
                 Margin="0,0,3,0"
                 Padding="5"
                 ItemsSource="{Binding SelectedGameFixesList}"
                 SelectedItem="{Binding SelectedFix, Mode=TwoWay}">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Grid Margin="10"
                          ColumnDefinitions="auto,*"
                          RowDefinitions="auto,auto,auto,auto,auto">

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).InstallUpdateFixCommand}"
                                          Header="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).InstallButtonText}" />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UninstallFixCommand}"
                                          Header="Uninstall" />
                                <MenuItem Margin="5"
                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenConfigCommand}"
                                          Header="Open config..." />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Border Grid.RowSpan="4"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SortedSymbol}" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Classes.IsInstalled="{Binding IsInstalled}"
                                   Text="{Binding Name}">

                            <TextBlock.Styles>
                                <Style Selector="TextBlock.IsInstalled">
                                    <Style.Setters>
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style.Setters>
                                </Style>
                            </TextBlock.Styles>

                        </TextBlock>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <TextBlock Margin="0"
                                       IsVisible="{Binding IsInstalled}"
                                       Opacity="80"
                                       Text="Installed" />

                            <TextBlock Margin="3,0,0,0"
                                       IsVisible="{Binding InstalledVersionStr, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="80"
                                       Text="v" />

                            <TextBlock Margin="0"
                                       IsVisible="{Binding InstalledVersionStr, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="80"
                                       Text="{Binding InstalledVersionStr}" />

                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding IsOutdated}"
                                   Text="Update available" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding MaybeOverwritten}"
                                   Text="Needs reinstall"
                                   ToolTip.Tip="The game has been updated since the fix was installed. It's recommended to unintall the fix, check files integrity on Steam, and install it again." />

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Margin="0"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"
                                   FontWeight="Thin"
                                   IsVisible="{Binding IsDisabled}"
                                   Text="Deprecated, can only be uninstalled" />

                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--Right column-->
        <Grid Grid.Column="2" RowDefinitions="*,auto,auto,auto,auto,auto,auto">

            <!--Description-->
            <TabControl IsVisible="{Binding SelectedFix, Converter={x:Static ObjectConverters.IsNotNull}}">

                <TabControl.Styles>

                    <Style Selector="TabControl">
                        <Setter Property="Padding" Value="3" />
                    </Style>

                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="10 3" />
                        <Setter Property="BorderThickness" Value="0" />

                        <Style Selector="^:selected">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10 3" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>

                        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10 3" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>

                    </Style>
                </TabControl.Styles>

                <TabItem Header="Description"
                         IsSelected="{Binding IsDescriptionSelected}"
                         IsVisible="{Binding SelectedFixChangelog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                    <mdv:MarkdownViewer Markdown="{Binding SelectedFixDescription}" />

                </TabItem>

                <TabItem Header="Changelog" IsVisible="{Binding SelectedFixChangelog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                    <mdv:MarkdownViewer Markdown="{Binding SelectedFixChangelog}" />

                </TabItem>

            </TabControl>

            <!--Requirements-->

            <Grid Grid.Row="1"
                  ColumnDefinitions="auto,*,auto"
                  RowDefinitions="auto,auto">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,6,0,0"
                           FontWeight="Bold"
                           IsVisible="{Binding SelectedFixRequirements, Converter={x:Static ObjectConverters.IsNotNull}}">
                    Requires:
                </TextBlock>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           FontWeight="Bold"
                           IsVisible="{Binding SelectedFixDependencies, Converter={x:Static ObjectConverters.IsNotNull}}">
                    Required by:
                </TextBlock>

                <ItemsControl Grid.Row="1"
                              Grid.Column="0"
                              ItemsSource="{Binding SelectedFixRequirements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Left" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1"
                              Grid.Column="2"
                              ItemsSource="{Binding SelectedFixDependencies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

            <!--Tags-->
            <Grid Grid.Row="2"
                  Margin="3,6,3,0"
                  ColumnDefinitions="auto,*"
                  IsVisible="{Binding SelectedFixTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                <TextBlock Grid.Column="0"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center">
                    Tags:
                </TextBlock>

                <ListBox Grid.Column="1"
                         Padding="2"
                         ItemsSource="{Binding SelectedFixTags}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0" Orientation="Horizontal">

                                <TextBlock Margin="5"
                                           VerticalAlignment="Center"
                                           Text="{Binding}" />

                                <Button Width="{Binding $self.Bounds.Height}"
                                        Margin="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=((vm:MainViewModel)DataContext).HideTagCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        ToolTip.Tip="Hide tag">
                                    <i:Icon Value="fa7-minus" />
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>

            <!--Stats-->
            <Grid Grid.Row="6"
                  Margin="3,6,3,0"
                  IsVisible="False">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--Installs-->
                <TextBlock Grid.Column="0"
                           Margin="3"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedFixNumberOfInstalls}" />

                <!--Score-->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsStatsVisible}"
                            Orientation="Horizontal">

                    <Button Margin="3"
                            Padding="7"
                            Classes.IsUpvoted="{Binding IsSelectedFixUpvoted}"
                            Command="{Binding UpvoteCommand}">

                        <Button.Styles>
                            <Style Selector="Button.IsUpvoted">
                                <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
                            </Style>
                        </Button.Styles>

                        <i:Icon Value="fa7-thumbs-up" />

                    </Button>

                    <TextBlock Margin="3"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedFixScore}" />

                    <Button Margin="3"
                            Padding="7"
                            Classes.IsDownvoted="{Binding IsSelectedFixDownvoted}"
                            Command="{Binding DownvoteCommand}">

                        <i:Icon Value="fa7-thumbs-down" />

                        <Button.Styles>
                            <Style Selector="Button.IsDownvoted">
                                <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
                            </Style>
                        </Button.Styles>

                    </Button>

                </StackPanel>

                <!--Report-->
                <Button Grid.Column="2"
                        Margin="3"
                        Padding="7"
                        HorizontalAlignment="Right"
                        Command="{Binding ReportFixCommand}"
                        IsVisible="{Binding IsStatsVisible}">
                    <i:Icon Value="fa7-flag" />
                </Button>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
