<UserControl x:Class="Avalonia.Desktop.UserControls.Editor.EditorFields"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ff="clr-namespace:Common.Entities.Fixes.FileFix;assembly=Superheater.Common"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:rf="clr-namespace:Common.Entities.Fixes.RegistryFix;assembly=Superheater.Common"
             xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
             xmlns:vme="clr-namespace:Avalonia.Desktop.ViewModels.Editor"
             d:DesignHeight="1000"
             d:DesignWidth="800"
             x:DataType="vme:EditorViewModel"
             mc:Ignorable="d">

    <UserControl.DataTemplates>
        <vme:EditorViewLocator />
    </UserControl.DataTemplates>

    <Grid IsVisible="{Binding SelectedFix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Grid.IsSharedSizeScope="True"
                    Orientation="Vertical">

            <!--Fix Type-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                    Fix Type
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <RadioButton Margin="0"
                                 GroupName="Type1"
                                 IsChecked="{Binding IsFileFixType}">
                        File
                    </RadioButton>

                    <RadioButton Margin="10,0"
                                 GroupName="Type2"
                                 IsChecked="{Binding IsRegistryFixType}">
                        Registry
                    </RadioButton>

                    <RadioButton Margin="10,0"
                                 GroupName="Type3"
                                 IsChecked="{Binding IsHostsFixType}">
                        Hosts
                    </RadioButton>

                    <RadioButton Margin="10,0"
                                 GroupName="Type4"
                                 IsChecked="{Binding IsTextFixType}">
                        Text
                    </RadioButton>
                </StackPanel>

            </Grid>

            <!--Supported OSes-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                    OSes
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <CheckBox Margin="0" IsChecked="{Binding IsWindowsChecked}">
                        Windows
                    </CheckBox>

                    <CheckBox Margin="10,0,0,0" IsChecked="{Binding IsLinuxChecked}">
                        Linux
                    </CheckBox>

                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!--Name-->
                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                    Name
                </TextBlock>

                <TextBox Name="NameTextBox"
                         Grid.Column="1"
                         Margin="0,3"
                         Text="{Binding SelectedFixName, Mode=TwoWay}" />

                <!--Version-->
                <TextBlock Grid.Column="2"
                           Margin="20,5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                    Version
                </TextBlock>

                <TextBox Grid.Column="4"
                         Width="100"
                         Margin="0,3"
                         Text="{Binding SelectedFixVersion, Mode=TwoWay}" />
            </Grid>

            <!--Tags-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center">
                    Tags
                </TextBlock>

                <TextBox Grid.Column="1"
                         Margin="0,3"
                         Text="{Binding SelectedFixTags, Mode=TwoWay}" />

                <Button Grid.Column="2"
                        Width="{Binding $self.Bounds.Height}"
                        Margin="5,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding OpenTagsEditorCommand}">
                    ...
                </Button>
            </Grid>

            <!--Hosts entries-->
            <Grid IsVisible="{Binding IsHostsFixType}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                    Hosts entries
                </TextBlock>

                <TextBox Grid.Column="1"
                         Margin="0,3"
                         Text="{Binding SelectedFixEntries, Mode=TwoWay}" />

                <Button Grid.Column="2"
                        Width="{Binding $self.Bounds.Height}"
                        Margin="5,0,0,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding OpenHostsEditorCommand}">
                    ...
                </Button>
            </Grid>

            <UserControl Content="{Binding FixDataContext}" />

            <!--Notes-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="MySizeGroup" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="5"
                           VerticalAlignment="Center">
                    Notes
                </TextBlock>

                <TextBox Grid.Column="1"
                         Margin="0,3"
                         Text="{Binding SelectedFix.Notes}" />
            </Grid>

            <!--Dependencies-->
            <Grid Margin="5"
                  ColumnDefinitions="*,auto,*"
                  RowDefinitions="*,*,*">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           Text="Available fixes" />

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           HorizontalAlignment="Center"
                           Text="Dependencies" />

                <ListBox Grid.Row="1"
                         Grid.RowSpan="2"
                         Grid.Column="0"
                         Padding="5"
                         ItemsSource="{Binding AvailableDependenciesList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedAvailableDependency}"
                         SelectionMode="Single" />

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Width="{Binding $self.Bounds.Height}"
                        Margin="1"
                        HorizontalContentAlignment="Center"
                        Command="{Binding AddDependencyCommand}"
                        ToolTip.Tip="Add dependency">
                    &gt;
                </Button>

                <ListBox Grid.Row="1"
                         Grid.RowSpan="2"
                         Grid.Column="2"
                         Padding="5"
                         ItemsSource="{Binding SelectedFixDependenciesList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedDependency}"
                         SelectionMode="Single" />

                <Button Grid.Row="2"
                        Grid.Column="1"
                        Width="{Binding $self.Bounds.Height}"
                        Margin="1"
                        HorizontalContentAlignment="Center"
                        Command="{Binding RemoveDependencyCommand}"
                        ToolTip.Tip="Remove dependency">
                    &lt;
                </Button>

            </Grid>

            <!--Preview JSON-->
            <Grid Margin="5">
                <Button Command="{Binding PreviewJsonCommand}">Preview JSON...</Button>
            </Grid>

        </StackPanel>

        <!--Description-->
        <Grid Grid.Row="1"
              Margin="0"
              ColumnDefinitions="*">

            <TabControl>

                <TabControl.Styles>

                    <Style Selector="TabControl">
                        <Setter Property="Background" />
                        <Setter Property="Padding" Value="3" />
                    </Style>

                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="10 3" />
                        <Setter Property="BorderThickness" Value="0" />

                        <Style Selector="^:selected">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10 3" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>

                        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10 3" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>

                    </Style>
                </TabControl.Styles>

                <TabItem Header="Description">
                    <Panel>
                        <TextBox AcceptsReturn="True"
                                 IsVisible="{Binding !IsChecked, ElementName=MdToggle}"
                                 Text="{Binding SelectedFixDescription, Mode=TwoWay}"
                                 TextWrapping="Wrap" />

                        <md:MarkdownScrollViewer IsVisible="{Binding IsChecked, ElementName=MdToggle}" Markdown="{Binding SelectedFixDescription}" />

                    </Panel>
                </TabItem>
                <TabItem Header="Changelog">
                    <Panel>
                        <TextBox AcceptsReturn="True"
                                 IsVisible="{Binding !IsChecked, ElementName=MdToggle}"
                                 Text="{Binding SelectedFixChangelog, Mode=TwoWay}"
                                 TextWrapping="Wrap" />

                        <md:MarkdownScrollViewer IsVisible="{Binding IsChecked, ElementName=MdToggle}" Markdown="{Binding SelectedFixChangelog}" />

                    </Panel>
                </TabItem>
            </TabControl>



            <ToggleButton Name="MdToggle"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsChecked="False">
                preview markdown
            </ToggleButton>
        </Grid>

    </Grid>


</UserControl>