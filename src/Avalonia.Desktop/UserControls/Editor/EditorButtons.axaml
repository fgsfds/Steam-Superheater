<UserControl x:Class="Avalonia.Desktop.UserControls.Editor.EditorButtons"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
             xmlns:vme="clr-namespace:Avalonia.Desktop.ViewModels.Editor"
             d:DesignHeight="100"
             d:DesignWidth="1000"
             x:DataType="vme:EditorViewModel"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">

            <ComboBox Name="GamesComboBox"
                      Width="200"
                      Height="{Binding #HowToSubmitButton.Bounds.Height}"
                      Margin="0,0,3,0"
                      Padding="8"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding !IsEmpty}"
                      ItemsSource="{Binding AvailableGamesList}"
                      SelectedItem="{Binding SelectedAvailableGame}" />

            <Button Width="{Binding $self.Bounds.Height}"
                    Height="{Binding #HowToSubmitButton.Bounds.Height}"
                    Margin="3,0"
                    Padding="8"
                    HorizontalContentAlignment="Center"
                    Command="{Binding AddNewGameCommand}">
                <i:Icon Value="fa7-plus" />
            </Button>

            <Button Width="{Binding $self.Bounds.Height}"
                    Height="{Binding #HowToSubmitButton.Bounds.Height}"
                    Margin="3,0"
                    Padding="8"
                    Command="{Binding UpdateGamesCommand}">
                <Grid>
                    <i:Icon Animation="Spin"
                            IsVisible="{Binding IsInProgress}"
                            Value="fa7-rotate" />
                    <i:Icon IsVisible="{Binding !IsInProgress}" Value="fa7-rotate" />
                </Grid>
            </Button>

            <TextBlock Margin="3,0"
                       Padding="8"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       IsVisible="{Binding IsEmpty}">
                &lt;- Press to start
            </TextBlock>

        </StackPanel>

        <StackPanel Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button Name="CancelButton"
                    Margin="3,0"
                    Padding="8"
                    Background="{DynamicResource SystemAccentColor}"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsVisible="{Binding LockButtons}" />

            <Button Name="HowToSubmitButton"
                    Margin="3,0"
                    Padding="8"
                    Background="{DynamicResource SystemAccentColor}"
                    Click="HowToSubmitButtonClick">
                How to submit fixes...
            </Button>

        </StackPanel>

    </Grid>
</UserControl>
