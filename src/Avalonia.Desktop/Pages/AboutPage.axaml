<UserControl x:Class="Avalonia.Desktop.Pages.AboutPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Common.Client;assembly=Superheater.Common.Client"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Avalonia.Desktop.ViewModels"
             d:DesignHeight="600"
             d:DesignWidth="800"
             x:DataType="vm:AboutViewModel"
             mc:Ignorable="d">

    <Grid ColumnDefinitions="*">

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical">

            <!--Version-->
            <Border Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource ButtonBackground}"
                    CornerRadius="3">

                <Grid ColumnDefinitions="auto,*, auto, auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Image Width="48" Source="/Assets/logo.png" />
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontSize="18">
                                Steam Superheater
                            </TextBlock>
                            <TextBlock Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Text="{Binding Source={x:Static cp:ClientProperties.CurrentVersion}}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                                 Margin="30,0"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsInProgress}" />
                    <Button Grid.Column="2"
                            Margin="10,0"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="{Binding CheckForUpdatesButtonText, FallbackValue=Check for updates}"
                            IsVisible="{Binding !IsUpdateAvailable}" />
                    <Button Grid.Column="2"
                            Margin="10,0"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SystemAccentColor}"
                            Command="{Binding DownloadAndInstallCommand}"
                            IsVisible="{Binding IsUpdateAvailable}">
                        Download and install
                    </Button>
                    <Button Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Click="ShowChangelogClick"
                            IsVisible="{Binding IsUpdateAvailable}">
                        Changelog...
                    </Button>
                </Grid>
            </Border>

            <!--Patreon-->
            <Button Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Click="PatreonClick">
                <StackPanel Orientation="Horizontal">

                    <i:Icon FontSize="48" Value="fa7-patreon" />

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="18">
                            Patreon
                        </TextBlock>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            Support me on Patreon
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!--Discord-->
            <Button Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Click="DiscordClick">
                <StackPanel Orientation="Horizontal">

                    <i:Icon FontSize="48" Value="fa7-discord" />

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="18">
                            Discord server
                        </TextBlock>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            Join discussion on Discord
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!--Github-->
            <Button Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Click="GitHubClick">
                <StackPanel Orientation="Horizontal">

                    <i:Icon FontSize="48" Value="fa7-github" />

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="18">
                            GitHub repository
                        </TextBlock>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            BuildLauncher is free and open source
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!--Issues-->
            <Button Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Click="GitHubIssuesClick">

                <StackPanel Orientation="Horizontal">

                    <i:Icon FontSize="48" Value="fa7-bug" />

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="18">
                            Report a problem
                        </TextBlock>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            Create issue on GitHub
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!--Signing-->
            <Button Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Click="SignPathClick">

                <StackPanel Orientation="Horizontal">

                    <Path Width="48"
                          Height="48"
                          Data="M133.4 22.8H62.6L27.1 84.2l35.4 61.4h70.9l35.4-61.4zm1.7 68.6c-.7 1.6-2.3 2.6-4.1 2.6H94.2c-2.5 0-4.5-2-4.5-4.5s2-4.5 4.5-4.5H121l-10.5-11.9a4.43 4.43 0 0 1 0-5.9L121 55.3H76.7v71.2c0 2.5-2 4.5-4.5 4.5s-4.5-2-4.5-4.5V41.7c0-2.5 2-4.5 4.5-4.5s4.5 2 4.5 4.5v4.6H131c1.8 0 3.4 1 4.1 2.6.7 1.6.4 3.5-.7 4.8L120 70.1l14.4 16.4c1.1 1.4 1.4 3.3.7 4.9z"
                          Fill="{Binding $parent[Button].Foreground}"
                          Stretch="Uniform" />

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="18">
                            Free code signing provided by SignPath.io
                        </TextBlock>
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            Certificate by SignPath Foundation
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

            </Button>

        </StackPanel>

    </Grid>

</UserControl>
